<%= form_with model: @task do |task| %>
  <%= task.label :title %>
  <%= task.text_field :title %>
  <%= task.label :details %>
  <%= task.text_field :details %>
  <%= task.checkbox :completed %>
  <%= task.label :completed, "Completed" %>
  <%= task.submit %>
<% end %>

<br>
<%= link_to "Back to list", tasks_path %>
