<h2><%= @task.title %></h2>
<p><%= @task.details %></p>
<input type="checkbox" <%= @task.completed? ? 'checked' : '' %> disabled value="1" /><label for="<%= @task.title %>"><%= @task.completed? ? 'This task is completed' : 'This task is not completed yet' %></label><br>
<br>
<%= link_to "Edit this task", edit_path %>
<br>
<%= link_to "Delete 🗑️", task_path(@task),
  data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} %>
<br>
<%= link_to "Back to list", tasks_path %>
